# Neon Postgres connection string
# Neon Dashboard → Project → Connection Details → Connection string
# Prefer "pooled" connection for Next.js / serverless
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Admin panel password
ADMIN_PASSWORD=your-admin-password

# Vercel Blob (required for image uploads on Vercel — filesystem is read-only there)
# Vercel Dashboard → Storage → Blob → Create → copy token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
